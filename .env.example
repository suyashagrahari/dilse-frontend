# ═══════════════════════════════════════════════════════════════════
#  ENVIRONMENT SWITCH  ←  Change ONLY this one line to switch envs
#  Options: local | ngrok | production
#
#  local      → localhost:3000        (no subdomain routing)
#  ngrok      → your dev domain       (subdomain routing, e.g. klyro.digital)
#  production → subhsandesh.in        (subdomain routing)
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_ENV=local


# ── LOCAL DEVELOPMENT ───────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=local
#  No subdomain routing — path-based /{username}/{shareId}
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:5000/api
NEXT_PUBLIC_LOCAL_SITE_URL=http://localhost:3000


# ── DEV DOMAIN / NGROK ──────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=ngrok
#  For klyro.digital subdomain testing:
#    NEXT_PUBLIC_NGROK_API_URL=https://klyro.digital:5000/api
#    NEXT_PUBLIC_NGROK_SITE_URL=https://klyro.digital
#    NEXT_PUBLIC_NGROK_ROOT_DOMAIN=klyro.digital
#  For a plain ngrok tunnel (no subdomains):
#    NEXT_PUBLIC_NGROK_API_URL=https://xxxx.ngrok-free.app/api
#    NEXT_PUBLIC_NGROK_SITE_URL=https://xxxx.ngrok-free.app
#    NEXT_PUBLIC_NGROK_ROOT_DOMAIN=   (leave empty)
NEXT_PUBLIC_NGROK_API_URL=https://klyro.digital:5000/api
NEXT_PUBLIC_NGROK_SITE_URL=https://klyro.digital
NEXT_PUBLIC_NGROK_ROOT_DOMAIN=klyro.digital


# ── PRODUCTION ──────────────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=production
#  Set these in Vercel / EC2 env vars panel — not in this file
NEXT_PUBLIC_PROD_API_URL=http://43.205.135.159:5000/api
NEXT_PUBLIC_PROD_SITE_URL=https://subhsandesh.in
NEXT_PUBLIC_PROD_ROOT_DOMAIN=subhsandesh.in


# ── GOOGLE OAUTH ────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Blog CMS (Strapi) ──────────────────────────────────────────────
# Base URL of the Strapi server per environment.
NEXT_PUBLIC_LOCAL_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_PROD_STRAPI_URL=https://strapi.subhsandesh.in
# Optional read-only Strapi API token (public read works without it).
STRAPI_API_TOKEN=
# Shared secret for the /api/revalidate webhook — MUST match cms/.env.
REVALIDATE_SECRET=change-me-to-a-long-random-string
# IndexNow instant-indexing key. Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Then create client/public/<KEY>.txt containing exactly the key.
INDEXNOW_KEY=


# ── ANALYTICS (GA4 + Microsoft Clarity) ─────────────────────────────
#  Both are OPTIONAL. An empty value fully disables that tool — every
#  track() call becomes a no-op. That is also the production kill switch:
#  blank the value, redeploy, analytics is off with no code change.
#
#  LEAVE THE LOCAL/NGROK ONES EMPTY unless you are deliberately testing.
#  Dev sessions and Playwright runs would otherwise land in the production
#  property as real user data, and GA4 cannot delete events afterwards.
#  To inspect events without sending anything, set this in the browser
#  console instead:  window.__ANALYTICS_DEBUG__ = true
#
#  IMPORTANT: NEXT_PUBLIC_* vars are inlined at BUILD time. Putting these
#  in the runtime env-file used by scripts/deploy.sh has NO effect — they
#  must be passed as Docker build-args (see client/Dockerfile and the
#  build-args blocks in .github/workflows/deploy*.yml).
NEXT_PUBLIC_LOCAL_GA_ID=
NEXT_PUBLIC_LOCAL_CLARITY_ID=
NEXT_PUBLIC_NGROK_GA_ID=
NEXT_PUBLIC_NGROK_CLARITY_ID=
#  Production values are set as GitHub Actions secrets, not in this file:
#    NEXT_PUBLIC_PROD_GA_ID       → e.g. G-XXXXXXXXXX
#    NEXT_PUBLIC_PROD_CLARITY_ID  → e.g. abcdefghij
NEXT_PUBLIC_PROD_GA_ID=
NEXT_PUBLIC_PROD_CLARITY_ID=

#  ── Media origin ────────────────────────────────────────────────────────────
#  Scheme + host for every remote asset (template covers, document animations,
#  apology-dashboard audio). The /gifts-media/... key path is appended by
#  lib/templateMedia.ts and does not change.
#
#  LEAVE EMPTY unless a CDN is verified working. Empty serves straight from the
#  bucket, which is correct today: objects already carry
#  `public, max-age=31536000, immutable` and go through next/image.
#
#  Before setting this, fetch one real key through the CDN and confirm a 200 —
#  as of this writing https://cdn.subhsandesh.in returns AccessDenied on every
#  path, including keys that return 200 straight from the bucket, so its origin
#  is not this bucket. Setting it early breaks every image on the site.
#
#    NEXT_PUBLIC_MEDIA_ORIGIN=https://cdn.subhsandesh.in
NEXT_PUBLIC_MEDIA_ORIGIN=
