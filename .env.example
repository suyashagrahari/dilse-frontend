# ═══════════════════════════════════════════════════════════════════
#  ENVIRONMENT SWITCH  ←  Change ONLY this one line to switch envs
#  Options: local | ngrok | production
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_ENV=local


# ── LOCAL DEVELOPMENT ───────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:5000/api
NEXT_PUBLIC_LOCAL_SITE_URL=http://localhost:3000


# ── NGROK TUNNEL ────────────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=ngrok
#  1. Run: ngrok http 5000
#  2. Copy the https URL ngrok gives you
#  3. Paste it in both the api url and site url below (without trailing slash)
#  4. Mirror the same URL in server/.env NGROK_URL
NEXT_PUBLIC_NGROK_API_URL=https://xxxx-xxxx-xxxx.ngrok-free.app/api
NEXT_PUBLIC_NGROK_SITE_URL=https://xxxx-xxxx-xxxx.ngrok-free.app


# ── PRODUCTION ──────────────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=production
#  DO NOT put production values here — add them directly in Vercel:
#  Vercel Dashboard → Project → Settings → Environment Variables
NEXT_PUBLIC_PROD_API_URL=https://your-production-api.com/api
NEXT_PUBLIC_PROD_SITE_URL=https://your-app.vercel.app


# ── GOOGLE OAUTH ────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
