# ═══════════════════════════════════════════════════════════════════
#  ENVIRONMENT SWITCH  ←  Change ONLY this one line to switch envs
#  Options: local | ngrok | production
#
#  local      → localhost:3000        (no subdomain routing)
#  ngrok      → your dev domain       (subdomain routing, e.g. klyro.digital)
#  production → subhsandesh.in        (subdomain routing)
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_ENV=local


# ── LOCAL DEVELOPMENT ───────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=local
#  No subdomain routing — path-based /{username}/{shareId}
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:5000/api
NEXT_PUBLIC_LOCAL_SITE_URL=http://localhost:3000


# ── DEV DOMAIN / NGROK ──────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=ngrok
#  For klyro.digital subdomain testing:
#    NEXT_PUBLIC_NGROK_API_URL=https://klyro.digital:5000/api
#    NEXT_PUBLIC_NGROK_SITE_URL=https://klyro.digital
#    NEXT_PUBLIC_NGROK_ROOT_DOMAIN=klyro.digital
#  For a plain ngrok tunnel (no subdomains):
#    NEXT_PUBLIC_NGROK_API_URL=https://xxxx.ngrok-free.app/api
#    NEXT_PUBLIC_NGROK_SITE_URL=https://xxxx.ngrok-free.app
#    NEXT_PUBLIC_NGROK_ROOT_DOMAIN=   (leave empty)
NEXT_PUBLIC_NGROK_API_URL=https://klyro.digital:5000/api
NEXT_PUBLIC_NGROK_SITE_URL=https://klyro.digital
NEXT_PUBLIC_NGROK_ROOT_DOMAIN=klyro.digital


# ── PRODUCTION ──────────────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=production
#  Set these in Vercel / EC2 env vars panel — not in this file
NEXT_PUBLIC_PROD_API_URL=http://43.205.135.159:5000/api
NEXT_PUBLIC_PROD_SITE_URL=https://subhsandesh.in
NEXT_PUBLIC_PROD_ROOT_DOMAIN=subhsandesh.in


# ── GOOGLE OAUTH ────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
