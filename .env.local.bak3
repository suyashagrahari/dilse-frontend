# ═══════════════════════════════════════════════════════════════════
#  ENVIRONMENT SWITCH  ←  Change ONLY this one line to switch envs
#  Options: local | ngrok | production
#
#  local      → http://localhost:3000  (no subdomain routing)
#  ngrok      → https://klyro.digital  (subdomain routing via klyro.digital)
#  production → https://subhsandesh.in (subdomain routing via subhsandesh.in)
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_ENV=local


# ── LOCAL DEVELOPMENT ───────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=local
#  No subdomain routing — uses path-based /{username}/{shareId}
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:5000/api
NEXT_PUBLIC_LOCAL_SITE_URL=http://localhost:3000


# ── DEV DOMAIN (klyro.digital) ──────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=ngrok
#  Enables full subdomain routing: {username}.klyro.digital/{shareId}
#  Make sure klyro.digital (and *.klyro.digital) DNS points to your machine
#  Keep NGROK_URL in server/.env in sync
NEXT_PUBLIC_NGROK_API_URL=https://klyro.digital:5000/api
NEXT_PUBLIC_NGROK_SITE_URL=https://klyro.digital
NEXT_PUBLIC_NGROK_ROOT_DOMAIN=klyro.digital


# ── PRODUCTION ──────────────────────────────────────────────────────
#  Used when NEXT_PUBLIC_APP_ENV=production
#  Set these in your hosting panel (Vercel / EC2) instead of here
NEXT_PUBLIC_PROD_API_URL=http://43.205.135.159:5000/api
NEXT_PUBLIC_PROD_SITE_URL=https://subhsandesh.in
NEXT_PUBLIC_PROD_ROOT_DOMAIN=subhsandesh.in


# ── GOOGLE OAUTH ────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=36027688258-mbtei3cgji2g7tp20tj2plcvev31fhe6.apps.googleusercontent.com

# ── Blog CMS (Strapi) ─────────────────────────────────────────────
# Point local dev at the PRODUCTION Strapi so the blog shows the same
# published posts as subhsandesh.in. Use http://localhost:1337 instead
# only when running the CMS locally (cd cms && npm run develop).
NEXT_PUBLIC_LOCAL_STRAPI_URL=https://strapi.subhsandesh.in
# Optional read-only Strapi API token (public read works without it)
STRAPI_API_TOKEN=
# Must match cms/.env REVALIDATE_SECRET — authorizes the publish webhook
REVALIDATE_SECRET=0857c2468eefbf00aad95115d904ae2029d1e6b57d18d7b6
# IndexNow instant-indexing key (matches public/<key>.txt)
INDEXNOW_KEY=7456db0aede2144602a8aab6182eadb1
