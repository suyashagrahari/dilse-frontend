# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files — never commit real secrets
.env
.env.local
.env.development
.env.production
# Allow the example/template file (no real secrets)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# template-factory skill run artifacts
.template-factory/

# Template media (court-marriage, hold-my-hand, train-ticket, legal-notice).
# Binary, identical in every environment, and served from S3 in all of them.
# Source of truth: <workspace>/media-src/templates  →  upload with
#   cd server && npm run upload:template-media
public/templates/

# Backups of env files.
#
# The narrow patterns below were added after `.env.local.bak` was committed
# once. They were not enough: `.env.local.bak3` still slipped through, because
# none of them match a suffix with a digit on the end. The rule that actually
# holds is the first one — anything that starts with `.env.` and is not
# `.env.example` — so prefer editing that over adding a fourth special case.
.env.*
!.env.example
*.env.bak
.env.*.bak
.env.local.bak
*.env.bak[0-9]*
.env.*.bak[0-9]*
